---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import DockNavigation from '../components/DockNavigation.astro';
import Icon from '../components/Icon.astro';
import AppointmentLink from '../components/AppointmentLink.astro';
import Appointment from '../components/Appointment.astro';
import Motion from '../components/Motion.astro';
import scanner from '../assets/tomografo-canon.png';
import facade from '../assets/santa-casa.png';
const modalities = [
  { title: 'Angiotomografia venosa', text: 'Imagens voltadas ao estudo das veias. Informe essa modalidade no agendamento para receber as orientações da nossa equipe.' },
  { title: 'Angiotomografia arterial', text: 'Imagens voltadas ao estudo das artérias. Nossa equipe confere seu pedido e orienta os próximos passos para realizar o exame.' },
  { title: 'Tomografia com contraste', text: 'Modalidade realizada com uso de contraste, conforme a indicação do pedido médico. As orientações de preparo são passadas pela equipe.' },
  { title: 'Tomografia sem contraste', text: 'Modalidade realizada sem uso de contraste. Tenha seu pedido médico em mãos para conversar com a equipe sobre o agendamento.' },
];
const services = [
  { number: '01', icon: 'bone', title: 'Densitometria óssea', copy: 'Um exame voltado à saúde dos seus ossos. Converse com a equipe sobre o seu pedido e o agendamento.', service: 'Densitometria óssea' },
  { number: '02', icon: 'heart', title: 'Exames sob sedação', copy: 'Conforto com acompanhamento médico. Consulte a possibilidade de realizar seu exame sob sedação.', service: 'Exame sob sedação' },
  { number: '03', icon: 'scan', title: 'Outros exames de imagem', copy: 'Está com um pedido e tem dúvidas? Consulte as modalidades disponíveis com a nossa equipe.', service: 'Quero consultar outros exames' },
];
const mapQuery = 'R. Antônio Pereira de Rezende, 19, Jardim Europa, Itaguara, MG, 35488-000';
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;
---
<Layout>
  <Header />
  <DockNavigation />
  <main id="conteudo">
    <section id="inicio" class="hero" aria-labelledby="hero-title">
      <figure class="hero-visual" data-hero-image>
        <Image src={scanner} alt="Tomógrafo Canon Aquilion Start do Centro de Imagem Itaguara, visto de frente" widths={[480, 768, 1024, 1440]} sizes="(max-width: 767px) 100vw, 70vw" format="webp" quality={85} loading="eager" fetchpriority="high" />
        <figcaption><span class="equipment-label">Tecnologia real. Cuidado próximo.</span><span>Canon Aquilion Start <Icon name="scan" size={16} /></span></figcaption>
      </figure>
      <div class="container hero-content">
        <div class="hero-copy">
          <p class="hero-kicker" data-hero-line><span class="status-dot"></span> Pioneiros em tomografia na região.</p>
          <h1 id="hero-title"><span class="headline-line" data-hero-line>Tomografia.</span><span class="headline-line" data-hero-line>Aqui, em</span><span class="headline-line headline-accent" data-hero-line>Itaguara.</span></h1>
          <p class="hero-description" data-hero-line>Diagnóstico por imagem com tecnologia real<br />e uma equipe que recebe você de perto.</p>
          <div class="hero-actions" data-hero-line><a class="phone-link" href="tel:+5531972541945"><Icon name="phone" size={17} /> (31) 97254-1945 <Icon name="diagonal" size={16} /></a></div>
        </div>
        <a class="hero-scroll" href="#quem-somos"><span>Conheça o centro</span><span class="scroll-arrow">↓</span></a>
      </div>
    </section>

    <section id="quem-somos" class="section about">
      <div class="container">
        <div class="chapter-label" data-reveal><span>01 / O centro</span><span>Da nossa região. Para a nossa gente.</span></div>
        <div class="about-statement" data-reveal><h2>Não é preciso ir longe<br />para <span>enxergar além.</span></h2><p>Somos o primeiro e mais completo centro de diagnósticos por imagem de Itaguara e região. Trouxemos a tomografia para perto. E colocamos você no centro de cada atendimento.</p></div>
        <div class="about-principles">
          <div data-reveal><span class="principle-mark"><Icon name="scan" size={22} /></span><h3>Pioneirismo que faz parte daqui.</h3><p>Fomos pioneiros em oferecer tomografia computadorizada na região.</p></div>
          <div data-reveal><span class="principle-mark"><Icon name="pin" size={22} /></span><h3>Tecnologia mais perto de casa.</h3><p>Diagnóstico por imagem em Itaguara, com um endereço que você conhece.</p></div>
          <div data-reveal><span class="principle-mark"><Icon name="heart" size={22} /></span><h3>Gente que recebe você.</h3><p>Uma equipe para acolher, esclarecer suas dúvidas e orientar cada etapa.</p></div>
        </div>
      </div>
    </section>

    <section id="tomografia-destaque" class="section tomography">
      <div class="container">
        <div class="chapter-label" data-reveal><span>02 / Tomografia</span><span>Precisão começa no olhar.</span></div>
        <div class="tomography-layout">
          <div class="tomography-copy" data-reveal><h2>Tomografia,<br /><span>em detalhe.</span></h2><p>Diferentes modalidades. Um equipamento real e uma equipe que orienta você, do agendamento ao preparo.</p><AppointmentLink service="Tomografia computadorizada" /><p class="small-copy">Selecione uma modalidade para saber mais.</p><div class="scan-orbit" aria-hidden="true"><span></span><span></span><span></span><i></i></div></div>
          <div class="modality-list">
            {modalities.map((modality, index) => <details class="modality" name="modalities" open={index === 0} data-reveal><summary><span class="modality-number">0{index + 1}</span><h3>{modality.title}</h3><span class="expand-icon" aria-hidden="true"></span></summary><div class="modality-content"><p>{modality.text}</p><a href="#agendamento" data-service={modality.title} class="text-link">Agendar exame <Icon name="arrow" size={18} /></a></div></details>)}
          </div>
        </div>
      </div>
    </section>

    <section id="nossos-servicos" class="section services">
      <div class="container">
        <div class="chapter-label" data-reveal><span>03 / Outros exames</span><span>O que você precisa, com quem cuida.</span></div>
        <div class="section-heading" data-reveal><h2>Além da<br /><span>tomografia.</span></h2><p>Seu pedido médico é o ponto de partida.<br />A gente ajuda com os próximos passos.</p></div>
        <div class="service-list">{services.map(service => <article class="service-row" data-reveal><span class="service-number">{service.number}</span><div class="service-name"><Icon name={service.icon} size={28} /><h3>{service.title}</h3></div><p>{service.copy}</p><AppointmentLink service={service.service} variant="text" /></article>)}</div>
      </div>
    </section>

    <section id="video-section" class="section facilities">
      <div class="container">
        <div class="chapter-label" data-reveal><span>04 / Por dentro</span><span>Portas abertas para você conhecer.</span></div>
        <div class="facilities-layout">
          <div class="facilities-copy" data-reveal><h2>Pode entrar.<br /><span>A casa é sua.</span></h2><p>Antes da sua visita, um primeiro encontro com o nosso espaço. Veja as instalações e o equipamento que fazem parte do seu atendimento.</p><a class="text-link" href="https://www.instagram.com/reel/DGCEqALxwR-/" target="_blank" rel="noopener noreferrer"><Icon name="instagram" size={20} /> Conheça pelo Instagram <Icon name="diagonal" size={18} /></a><div class="facilities-signature"><span class="signature-line"></span><p>Um centro de imagem.<br /><strong>Um olhar para cada pessoa.</strong></p></div></div>
          <div class="video-stage" data-reveal><span class="video-edge-label" aria-hidden="true">CENTRO DE IMAGEM / ITAGUARA</span><div class="instagram-frame"><div class="instagram-viewport"><iframe src="https://www.instagram.com/reel/DGCEqALxwR-/embed" title="Conheça as instalações do Centro de Imagem Itaguara no Instagram" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture; web-share" allowfullscreen></iframe></div><a class="embed-fallback" href="https://www.instagram.com/reel/DGCEqALxwR-/" target="_blank" rel="noopener noreferrer">Ver publicação no Instagram <Icon name="diagonal" size={16} /></a></div></div>
        </div>
      </div>
    </section>

    <section id="localizacao" class="section location">
      <div class="container">
        <div class="chapter-label" data-reveal><span>05 / Onde estamos</span><span>Itaguara, Minas Gerais.</span></div>
        <div class="section-heading" data-reveal><h2>A gente está<br /><span>logo ali.</span></h2><p>No complexo da Santa Casa de Itaguara.<br />Use a Emergência como referência de chegada.</p></div>
        <div class="location-layout">
          <figure class="facade-figure" data-reveal><Image src={facade} alt="Fachada da Santa Casa de Itaguara com a entrada da Emergência, referência para chegar ao Centro de Imagem" widths={[480, 768, 1024]} sizes="(max-width: 767px) 100vw, 40vw" format="webp" quality={85} loading="lazy" /><figcaption><Icon name="pin" size={16} /> Santa Casa de Itaguara · Referência de localização</figcaption></figure>
          <div class="location-info"><div class="location-details" data-reveal><span class="eyebrow">Anote o endereço</span><address>R. Antônio Pereira<br />de Rezende, 19</address><p>1º Andar, Sala 5 B — Jardim Europa<br />Itaguara — MG · CEP 35488-000</p><p class="location-reference">O atendimento do Centro de Imagem é no endereço acima. A Emergência é nosso ponto de referência.</p><div class="location-actions"><a class="text-link" href={mapLink} target="_blank" rel="noopener noreferrer">Como chegar <Icon name="diagonal" size={18} /></a></div></div><div class="map-frame" data-reveal><iframe src={`https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`} title="Mapa de localização do Centro de Imagem Integrado de Itaguara" width="600" height="260" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div></div>
        </div>
      </div>
    </section>
    <Appointment />
  </main>
  <footer class="site-footer"><div class="container"><div class="footer-main"><a class="footer-wordmark" href="#inicio">Centro de Imagem<span>Integrado de Itaguara.</span></a><a class="footer-instagram" href="https://www.instagram.com/centrodeimagemitaguara/" target="_blank" rel="noopener noreferrer"><Icon name="instagram" size={21} /> Acompanhe de perto <Icon name="diagonal" size={18} /></a></div><div class="footer-bottom"><p>© {new Date().getFullYear()} Centro de Imagem Integrado de Itaguara.</p><p>CNPJ: 55.744.378/0001-91</p><a href="#inicio">Voltar ao topo ↑</a></div></div></footer>
  <Motion />
</Layout>
